# Required for live scoring
TYPESAFE_API_KEY=

# Optional; used only to extract structured requirements from a job description
ANTHROPIC_API_KEY=

# Pin Jev for repeatable scoring; do not use jev-latest in production.
JEV_MODEL=jev-1.13.0

# Local SQLite database, uploaded files, and JD cache
DATA_DIR=./data

# Optional
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
MAX_FILE_BYTES=5242880
MAX_REQUEST_BYTES=26214400
MAX_CONCURRENT_RESUMES=3
MAX_RESUMES_PER_MATCH=25
MAX_REQUIREMENTS_PER_MATCH=50
MAX_RESUME_TEXT_CHARS=200000
MAX_PDF_PAGES=50
MAX_DOCX_MEMBERS=1000
MAX_DOCX_UNCOMPRESSED_BYTES=26214400
MAX_DOCX_COMPRESSION_RATIO=100
PROMPT_INJECTION_THRESHOLD=0.35
EVIDENCE_PRESENCE_THRESHOLD=0.35
EVIDENCE_THRESHOLD=0.6
EVIDENCE_LIMIT=3
EVIDENCE_CANDIDATE_LIMIT=8
EVIDENCE_WINDOW_LINES=200
MAX_EVIDENCE_LINES=400
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
MATCH_RATE_LIMIT_PER_WINDOW=10
UPLOAD_RATE_LIMIT_PER_WINDOW=30
EXTRACTION_RATE_LIMIT_PER_WINDOW=10
DEFAULT_RATE_LIMIT_PER_WINDOW=120
API_BASE_URL=http://localhost:8000
