# Required for live scoring
TYPESAFE_API_KEY=

# Required to extract structured requirements from a job description
ANTHROPIC_API_KEY=

# Pin Jev for repeatable scoring; do not use jev-latest in production.
JEV_MODEL=jev-1.13.0

# Local SQLite database, uploaded files, and JD cache
DATA_DIR=./data

# Optional
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
API_BASE_URL=http://localhost:8000
